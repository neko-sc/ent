{{ define "mutation" }}
{{ template "header" $ }}
{{ with extend $ "Imports" $.SiblingImports }}{{ template "import" . }}{{ end }}

// {{ $.Name }}Insert is the write representation of a {{ $.Name }} creation.
type {{ $.Name }}Insert struct {
{{- range $f := $.InsertFields }}
    {{ $f.StructField }} {{ if $f.InsertOptional }}ent.Option[{{ $f.GoType }}]{{ else }}{{ $f.GoType }}{{ end }} `json:"{{ $f.Name }}{{ if $f.InsertOptional }},omitzero{{ end }}"`
{{- end }}
{{- range $e := $.EdgesWithID }}{{ if not $e.Field }}
    {{ $e.InsertSlot }} {{ if $e.Unique }}ent.Option[{{ $e.Type.ID.GoType }}]{{ else }}[]{{ $e.Type.ID.GoType }}{{ end }} `json:"{{ snake $e.InsertSlot }},omitzero"`
{{- end }}{{ end }}
    expressions map[string]func(*sql.Builder)
}

// {{ $.Name }}Patch is the write representation of a {{ $.Name }} update.
type {{ $.Name }}Patch struct {
{{- range $f := $.MutableFields }}
    {{ $f.StructField }} ent.Option[{{ $f.GoType }}] `json:"{{ $f.Name }},omitzero"`
    {{- if $f.SupportsMutationAdd }}
    {{ $f.StructField }}Add ent.Option[{{ $f.MutationAddType }}] `json:"{{ $f.Name }}_add,omitzero"`
    {{- end }}
    {{- if $f.SupportsMutationAppend }}
    {{ $f.StructField }}Append {{ $f.GoType }} `json:"{{ $f.Name }}_append,omitzero"`
    {{- end }}
{{- end }}
{{- range $e := $.EdgesWithID }}{{ if and (not $e.Immutable) (not $e.Field) }}
    {{ $e.PatchSlot }} {{ if $e.Unique }}ent.Option[{{ $e.Type.ID.GoType }}]{{ else }}ent.RelationPatch[{{ $e.Type.ID.GoType }}]{{ end }} `json:"{{ snake $e.PatchSlot }},omitzero"`
{{- end }}{{ end }}
    expressions map[string]func(*sql.Builder)
    clearedEdges map[string]bool
}

{{ range $patch := list false true }}
{{ $type := print $.Name "Insert" }}{{ $fields := $.InsertFields }}{{ if $patch }}{{ $type = print $.Name "Patch" }}{{ $fields = $.MutableFields }}{{ end }}
func (i *{{ $type }}) set(column string, value any) error {
    switch column {
    {{ range $f := $fields }}
    case {{ $.Package }}.{{ $f.Constant }}:
        v, ok := value.({{ $f.GoType }})
        if !ok { return &ValidationError{Name: column, err: fmt.Errorf("ent: unexpected type %T for field %q of {{ $.Name }}", value, column)} }
        i.{{ $f.StructField }} = {{ if or $patch $f.InsertOptional }}ent.Some(v){{ else }}v{{ end }}
        {{ if $patch }}
        {{ if $f.SupportsMutationAdd }}i.{{ $f.StructField }}Add = ent.Unset[{{ $f.MutationAddType }}](){{ end }}
        {{ if $f.SupportsMutationAppend }}i.{{ $f.StructField }}Append = nil{{ end }}
        {{ end }}
        delete(i.expressions, column)
        return nil
    {{ end }}
    }
    return &ValidationError{Name: column, err: fmt.Errorf("ent: field %q of {{ $.Name }} is not settable", column)}
}

func (i *{{ $type }}) setNull(column string) error {
    switch column {
    {{ range $f := $fields }}{{ if $f.Optional }}
    case {{ $.Package }}.{{ $f.Constant }}:
        i.{{ $f.StructField }} = ent.Null[{{ $f.GoType }}]()
        {{ if $patch }}
        {{ if $f.SupportsMutationAdd }}i.{{ $f.StructField }}Add = ent.Unset[{{ $f.MutationAddType }}](){{ end }}
        {{ if $f.SupportsMutationAppend }}i.{{ $f.StructField }}Append = nil{{ end }}
        {{ end }}
        delete(i.expressions, column)
        return nil
    {{ end }}{{ end }}
    }
    return &ValidationError{Name: column, err: fmt.Errorf("ent: field %q of {{ $.Name }} is not nullable", column)}
}

func (i *{{ $type }}) setExpr(column string, render func(*sql.Builder)) {
    if i.expressions == nil { i.expressions = make(map[string]func(*sql.Builder)) }
    i.expressions[column] = render
}

func (i *{{ $type }}) setEdge(edge string, id any) error {
    switch edge {
    {{ range $e := $.EdgesWithID }}{{ if and $e.Unique (or (not $patch) (not $e.Immutable)) }}
    case {{ $.Package }}.{{ $e.Constant }}:
        value, ok := id.({{ $e.Type.ID.GoType }})
        if !ok { return &ValidationError{Name: edge, err: fmt.Errorf("ent: unexpected ID type %T for edge %q of {{ $.Name }}", id, edge)} }
        {{ if $e.Field }}return i.set({{ $.Package }}.{{ $e.Field.Constant }}, value){{ else }}i.{{ $e.InsertSlot }} = ent.Some(value); return nil{{ end }}
    {{ end }}{{ end }}
    }
    return &ValidationError{Name: edge, err: fmt.Errorf("ent: edge %q of {{ $.Name }} is not settable", edge)}
}

func (i *{{ $type }}) addIDs(edge string, ids ...any) error {
    switch edge {
    {{ range $e := $.EdgesWithID }}{{ if and (not $e.Unique) (or (not $patch) (not $e.Immutable)) }}
    case {{ $.Package }}.{{ $e.Constant }}:
        for _, id := range ids {
            value, ok := id.({{ $e.Type.ID.GoType }})
            if !ok { return &ValidationError{Name: edge, err: fmt.Errorf("ent: unexpected ID type %T for edge %q of {{ $.Name }}", id, edge)} }
            {{ if $patch }}i.{{ $e.PatchSlot }}.Add = append(i.{{ $e.PatchSlot }}.Add, value){{ else }}i.{{ $e.InsertSlot }} = append(i.{{ $e.InsertSlot }}, value){{ end }}
        }
        return nil
    {{ end }}{{ end }}
    }
    return &ValidationError{Name: edge, err: fmt.Errorf("ent: edge %q of {{ $.Name }} does not accept IDs", edge)}
}

{{ range $e := $.EdgesWithID }}{{ if or (not $patch) (not $e.Immutable) }}
func (i *{{ $type }}) {{ camel $e.StructField }}IDs() []{{ $e.Type.ID.GoType }} {
    {{ if $e.Unique }}
        {{ if and (not $patch) $e.Field (not $e.Field.InsertOptional) }}return []{{ $e.Type.ID.GoType }}{i.{{ $e.InsertSlot }}}{{ else }}
        if id, ok := i.{{ $e.InsertSlot }}.Get(); ok { return []{{ $e.Type.ID.GoType }}{id} }
        return nil
        {{ end }}
    {{ else if $patch }}return i.{{ $e.PatchSlot }}.Add
    {{ else }}return i.{{ $e.InsertSlot }}{{ end }}
}
{{ end }}{{ end }}
{{ end }}

func (p *{{ $.Name }}Patch) add(column string, value any) error {
    switch column {
    {{ range $f := $.MutableFields }}{{ if $f.SupportsMutationAdd }}
    case {{ $.Package }}.{{ $f.Constant }}:
        delta, ok := value.({{ $f.MutationAddType }})
        {{ if ne $f.GoType (print $f.MutationAddType) }}
        if !ok { if v, matches := value.({{ $f.GoType }}); matches { delta, ok = {{ $f.MutationAddType }}(v), true } }
        {{ end }}
        if !ok { return &ValidationError{Name: column, err: fmt.Errorf("ent: unexpected addition type %T for field %q", value, column)} }
        if current, exists := p.{{ $f.StructField }}Add.Get(); exists {
            {{ if $f.Semantic.Capabilities.Adder }}delta = current.Add(delta){{ else }}delta += current{{ end }}
        }
        p.{{ $f.StructField }}Add = ent.Some(delta)
        return nil
    {{ end }}{{ end }}
    }
    return &ValidationError{Name: column, err: fmt.Errorf("ent: field %q of {{ $.Name }} does not support addition", column)}
}

func (p *{{ $.Name }}Patch) appendValues(column string, value any) error {
    switch column {
    {{ range $f := $.MutableFields }}{{ if $f.SupportsMutationAppend }}
    case {{ $.Package }}.{{ $f.Constant }}:
        values, ok := value.({{ $f.GoType }})
        if !ok { return &ValidationError{Name: column, err: fmt.Errorf("ent: unexpected append type %T for field %q", value, column)} }
        p.{{ $f.StructField }}Append = append(p.{{ $f.StructField }}Append, values...)
        return nil
    {{ end }}{{ end }}
    }
    return &ValidationError{Name: column, err: fmt.Errorf("ent: field %q of {{ $.Name }} does not support append", column)}
}

func (p *{{ $.Name }}Patch) removeIDs(edge string, ids ...any) error {
    switch edge {
    {{ range $e := $.EdgesWithID }}{{ if and (not $e.Unique) (not $e.Immutable) }}
    case {{ $.Package }}.{{ $e.Constant }}:
        for _, id := range ids {
            value, ok := id.({{ $e.Type.ID.GoType }})
            if !ok { return &ValidationError{Name: edge, err: fmt.Errorf("ent: unexpected ID type %T for edge %q", id, edge)} }
            p.{{ $e.PatchSlot }}.Remove = append(p.{{ $e.PatchSlot }}.Remove, value)
            p.{{ $e.PatchSlot }}.Add = slices.DeleteFunc(p.{{ $e.PatchSlot }}.Add, func(id {{ $e.Type.ID.GoType }}) bool { return id == value })
        }
        return nil
    {{ end }}{{ end }}
    }
    return &ValidationError{Name: edge, err: fmt.Errorf("ent: edge %q of {{ $.Name }} does not support removal", edge)}
}

func (p *{{ $.Name }}Patch) clearEdge(edge string) error {
    switch edge {
    {{ range $e := $.EdgesWithID }}{{ if not $e.Immutable }}
    case {{ $.Package }}.{{ $e.Constant }}:
        {{ if $e.Unique }}
        {{ if not $e.Optional }}return &ValidationError{Name: edge, err: fmt.Errorf("ent: edge %q of {{ $.Name }} is required", edge)}{{ else }}
        if p.clearedEdges == nil { p.clearedEdges = make(map[string]bool) }; p.clearedEdges[edge] = true
        {{ if $e.Field }}return p.setNull({{ $.Package }}.{{ $e.Field.Constant }}){{ else }}p.{{ $e.PatchSlot }} = ent.Null[{{ $e.Type.ID.GoType }}](); return nil{{ end }}
        {{ end }}
        {{ else }}p.{{ $e.PatchSlot }}.Clear = true; return nil{{ end }}
    {{ end }}{{ end }}
    }
    return &ValidationError{Name: edge, err: fmt.Errorf("ent: edge %q of {{ $.Name }} cannot be cleared", edge)}
}

func (p *{{ $.Name }}Patch) apply(other {{ $.Name }}Patch) {
    {{ range $f := $.MutableFields }}
    if other.{{ $f.StructField }}.IsSet() { p.{{ $f.StructField }} = other.{{ $f.StructField }}; delete(p.expressions, {{ $.Package }}.{{ $f.Constant }}) }
    {{ if $f.SupportsMutationAdd }}
    if value, ok := other.{{ $f.StructField }}Add.Get(); ok {
        if current, exists := p.{{ $f.StructField }}Add.Get(); exists {
            {{ if $f.Semantic.Capabilities.Adder }}value = current.Add(value){{ else }}value += current{{ end }}
        }
        p.{{ $f.StructField }}Add = ent.Some(value)
    }
    {{ end }}
    {{ if $f.SupportsMutationAppend }}p.{{ $f.StructField }}Append = append(p.{{ $f.StructField }}Append, other.{{ $f.StructField }}Append...){{ end }}
    {{ end }}
    {{ range $e := $.EdgesWithID }}{{ if and (not $e.Immutable) (not $e.Field) }}
    {{ if $e.Unique }}if other.{{ $e.PatchSlot }}.IsSet() { p.{{ $e.PatchSlot }} = other.{{ $e.PatchSlot }} }{{ else }}
    p.{{ $e.PatchSlot }}.Add = append(p.{{ $e.PatchSlot }}.Add, other.{{ $e.PatchSlot }}.Add...)
    p.{{ $e.PatchSlot }}.Remove = append(p.{{ $e.PatchSlot }}.Remove, other.{{ $e.PatchSlot }}.Remove...)
    p.{{ $e.PatchSlot }}.Clear = p.{{ $e.PatchSlot }}.Clear || other.{{ $e.PatchSlot }}.Clear
    {{ end }}{{ end }}{{ end }}
    for column, render := range other.expressions { p.setExpr(column, render) }
    for edge, clear := range other.clearedEdges { if clear { if p.clearedEdges == nil { p.clearedEdges = make(map[string]bool) }; p.clearedEdges[edge] = true } }
}
{{ end }}
