{{/* gotype: github.com/neko-sc/ent/entc/gen.Graph */}}

{{ define "import" }}
import (
	"context"
	"errors"
	"fmt"
	"math"
	"strings"
	"sync"
	"time"
	{{- if ne $.Config.Package $.Package }}
		"{{ $.Config.Package }}/predicate"
		{{- range $import := $.SemanticImports }}
			{{ if $import.Alias }}{{ $import.Alias }} {{ end }}"{{ $import.Path }}"
		{{- end }}
	{{- end }}
	"github.com/neko-sc/ent"
	"github.com/neko-sc/ent/dialect"
	"github.com/neko-sc/ent/schema/field"
	{{- with $.Storage }}
		{{- range $import := .Imports }}
			"{{ $import }}"
		{{- end }}
	{{- end }}
	{{- if and (hasField $ "Scope") ($.Scope.Imports) }}
		{{- range $import := $.Scope.Imports }}
			{{ $import.Alias }} "{{ $import.Path }}"
		{{- end }}
	{{- end }}
	{{- template "import/additional" $ }}
)
{{ end }}

{{ define "import/additional" }}
	{{- with $tmpls := matchTemplate "import/additional/*" }}
		{{- range $tmpl := $tmpls }}
			{{- xtemplate $tmpl $ }}
		{{- end }}
	{{- end }}
	{{- if $.Storage }}
		{{- with $tmpls := matchTemplate (printf "dialect/%s/import/additional/*" $.Storage) }}
			{{- range $tmpl := $tmpls }}
				{{- xtemplate $tmpl $ }}
			{{- end }}
		{{- end }}
	{{- end }}
{{ end }}
