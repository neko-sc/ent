{{ define "mutation_graph" }}
{{ template "header" $ }}
{{ template "import" $ }}
import (
{{ range $n := $.Nodes }}
{{ $n.PackageAlias }} "{{ $.Config.Package }}/{{ $n.PackageDir }}"
{{ end }}
)
const (
    OpCreate = ent.OpCreate
    OpUpdate = ent.OpUpdate
    OpUpdateOne = ent.OpUpdateOne
    OpDelete = ent.OpDelete
    OpDeleteOne = ent.OpDeleteOne
    {{ range $n := $.Nodes }}
{{ $n.TypeName }} = "{{ $n.Name }}"
{{ end }}
)
{{ range $n := $.MutableNodes }}
type {{ $n.MutationName }} struct {
    config
    op ent.Op
    {{ if $n.HasOneFieldID }}id *{{ $n.ID.GoType }}{{ end }}
    insert *{{ $n.Name }}Insert
    patch *{{ $n.Name }}Patch
    predicates []ent.Predicate[entity.{{ $n.Name }}]
}

func new{{ $n.MutationName }}(c config, op ent.Op) *{{ $n.MutationName }} {
    m := &{{ $n.MutationName }}{config: c, op: op}
    if op.Is(OpCreate) { m.insert = &{{ $n.Name }}Insert{} }
    if op.Is(OpUpdate | OpUpdateOne) { m.patch = &{{ $n.Name }}Patch{} }
    return m
}

func(m *{{ $n.MutationName }}) Op() ent.Op { return m.op }

func(m *{{ $n.MutationName }}) Type() string { return "{{ $n.Name }}" }

func(m *{{ $n.MutationName }}) Insert() *{{ $n.Name }}Insert { return m.insert }

func(m *{{ $n.MutationName }}) Patch() *{{ $n.Name }}Patch { return m.patch }

func(m *{{ $n.MutationName }}) Predicates() []ent.Predicate[entity.{{ $n.Name }}] { return m.predicates }

func(m *{{ $n.MutationName }}) Where(predicates ...ent.Predicate[entity.{{ $n.Name }}]) { m.predicates = append(m.predicates, predicates...) }

func(m *{{ $n.MutationName }}) Client() *Client {
    client := &Client{config: m.config}
    client.init()
    return client
}

func(m *{{ $n.MutationName }}) Tx() (*Tx, error) {
    if _, ok := m.driver.(*txDriver); !ok { return nil, errors.New("ent: mutation is not running in a transaction") }
    tx := &Tx{config: m.config}
    tx.init()
    return tx, nil
}
{{ if $n.HasOneFieldID }}

func(m *{{ $n.MutationName }}) ID() (id {{ $n.ID.GoType }}, exists bool) {
    if m.id != nil { return *m.id, true }
    {{ if $n.ID.UserDefined }}if m.insert != nil { return m.insert.ID.Get() }{{ end }}
    return id, false
}

func(m *{{ $n.MutationName }}) IDs(ctx context.Context) ([]{{ $n.ID.GoType }}, error) {
    switch {
    case m.op.Is(OpUpdateOne | OpDeleteOne):
        if id, exists := m.ID(); exists { return []{{ $n.ID.GoType }}{id}, nil }
        fallthrough
    case m.op.Is(OpUpdate | OpDelete):
        return m.Client().{{ $n.Name }}.Query().Where(m.predicates...).IDs(ctx)
    default:
        return nil, fmt.Errorf("IDs is not allowed on %s operations", m.op)
    }
}
{{ end }}
{{ end }}
{{ end }}
