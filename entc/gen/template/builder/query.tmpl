{{ if $.HasOneFieldID }}
	// IDs executes the query and returns a list of {{ $.Name }} IDs.
	func ({{ $receiver }} *{{ $builder }}) IDs(ctx context.Context) (ids []{{ $.ID.GoType }}, err error) {
		{{- /* Since a graph traversal such as JOINs can return duplicate IDs, set the Unique modifier unless specified otherwise. */}}
		if {{ $receiver }}.ctx.Unique == nil && {{ $receiver }}.path != nil {
			{{ $receiver }}.Unique(true)
		}
		{{- if and $.ID.HasValueScanner (eq $.Storage.Name "sql") }}
			var nodes []*{{ $.Name }}
			{{ $receiver }}.ctx.Fields = []string{ {{ $.Package }}.FieldID }
			if nodes, err = {{ $receiver }}.All(ctx); err != nil {
				return nil, err
			}
			ids = make([]{{ $.ID.GoType }}, len(nodes))
			for i := range nodes {
				ids[i] = nodes[i].ID
			}
		{{- else }}
			if ids, err = ent.Values(ctx, {{ $receiver }}.Select({{ $.Package }}.ID), {{ $.Package }}.ID); err != nil {
				return nil, err
			}
		{{- end }}
		return ids, nil
	}

	// IDsX is like IDs, but panics if an error occurs.
	func ({{ $receiver }} *{{ $builder }}) IDsX(ctx context.Context) []{{ $.ID.GoType }} {
		ids, err := {{ $receiver }}.IDs(ctx)
		if err != nil {
			panic(err)
		}
		return ids
	}
{{ end }}

// Count returns the count of the given query.
func ({{ $receiver }} *{{ $builder }}) Count(ctx context.Context) (int, error) {
	if err := {{ $receiver }}.prepareQuery(ctx); err != nil {
		return 0, err
