// GroupBy is used to group vertices by one or more fields/columns.
// It can be combined with typed aggregate selections.
{{- with len $.Fields }}
{{- $f := index $.Fields 0 }}
//
// Example:
//
//	var v []struct {
//		{{ $f.StructField }} {{ $f.GoType }} `{{ $f.StructTag }}`
//		Count int `json:"count,omitempty"`
//	}
//
//	client.{{ pascal $.Name }}.Query().
//		GroupBy({{ $.Package }}.{{ $f.StructField }}).
//		Aggregate({{ $pkg }}.Count()).
//		Scan(ctx, &v)
//
{{- end }}
func ({{ $receiver }} *{{ $builder }}) GroupBy(columns ...ent.EntityColumn[entity.{{ $.Name }}]) *{{ $groupBuilder }} {
	if len(columns) == 0 { panic("ent: GroupBy requires at least one column") }
	return &{{ $groupBuilder }}{query: {{ $receiver }}, columns: append([]ent.EntityColumn[entity.{{ $.Name }}](nil), columns...)}
}

