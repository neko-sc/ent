{{ $selectReceiver := $.SelectReceiver }}

// {{ $selectBuilder }} is the builder for selecting fields of {{ pascal $.Name }} entities.
type {{ $selectBuilder }} struct {
	query *{{ $builder }}
	selections []ent.Selection
	groups []ent.EntityColumn[entity.{{ $.Name }}]
}

func ({{ $selectReceiver }} *{{ $selectBuilder }}) Aggregate(selections ...ent.Selection) *{{ $selectBuilder }} {
	{{ $selectReceiver }}.selections = append({{ $selectReceiver }}.selections, selections...)
	return {{ $selectReceiver }}
}

func ({{ $selectReceiver }} *{{ $selectBuilder }}) Row(ctx context.Context) (*ent.Row, error) {
	rows, err := {{ $selectReceiver }}.Rows(ctx)
	if err != nil { return nil, err }
	switch len(rows) {
	case 0: return nil, &NotFoundError{ {{ $.Package }}.Label }
	case 1: return rows[0], nil
	default: return nil, &NotSingularError{ {{ $.Package }}.Label }
	}
}

