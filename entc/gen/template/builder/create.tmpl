    {{ end }}
    {{ if or $f.IsEnum $f.Validators $f.TypeValidator }}
    if b.mutation.insert.expressions[{{ $.Package }}.{{ $f.Constant }}] == nil {
        {{ if $f.InsertOptional }}if v, ok := b.mutation.insert.{{ $f.StructField }}.Get(); ok { {{ else }}v := b.mutation.insert.{{ $f.StructField }}{{ end }}
        {{ with extend $ "Field" $f }}{{ template "write/validate" . }}{{ end }}
        {{ if $f.InsertOptional }}}{{ end }}
    }
    {{ end }}
    {{ end }}
    {{ range $e := $.EdgesWithID }}{{ if not $e.Optional }}
    if len(b.mutation.insert.{{ camel $e.StructField }}IDs()) == 0 { return &ValidationError{Name: "{{ $e.Name }}", err: errors.New(`ent: missing required edge "{{ $.Name }}.{{ $e.Name }}"`)} }
    {{ end }}{{ end }}
    return nil
}
