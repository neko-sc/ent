{{ define "update" }}
{{ template "header" $ }}
{{ with extend $ "Imports" $.SiblingImports }}{{ template "import" . }}{{ end }}
{{ range $one := list false true }}
{{ $builder := $.UpdateName }}{{ $receiver := $.UpdateReceiver }}{{ $result := "int" }}{{ $zero := "0" }}
{{ if $one }}{{ $builder = $.UpdateOneName }}{{ $receiver = $.UpdateOneReceiver }}{{ $result = print "*" $.Name }}{{ $zero = "nil" }}{{ end }}
type {{ $builder }} struct {
    config
    mutation *{{ $.MutationName }}
    err error
    {{ if not $one }}returning *sqlgraph.Returning{{ end }}
    {{ if $one }}
    fields []string
    old *{{ $.Name }}
    {{ if $.HasCompositeID }}{{ range $id := $.EdgeSchema.ID }}
    {{ camel $id.StructField }} {{ $id.GoType }}
    {{ end }}{{ end }}
    {{ end }}
    {{ template "dialect/sql/update/fields" $ }}
}
{{ with extend $ "Builder" $builder "Receiver" $receiver }}{{ template "write/methods" . }}{{ end }}

func(b *{{ $builder }}) Where(predicates ...ent.Predicate[entity.{{ $.Name }}]) *{{ $builder }} { b.mutation.Where(predicates...); return b }

func(b *{{ $builder }}) Save(ctx context.Context) ({{ $result }}, error) {
    if b.err != nil { return {{ $zero }}, b.err }
    if err := b.defaults(); err != nil { return {{ $zero }}, err }
    return b.sqlSave(ctx)
}

func(b *{{ $builder }}) SaveX(ctx context.Context) {{ $result }} {
    result, err := b.Save(ctx); if err != nil { panic(err) }; return result
}

func(b *{{ $builder }}) Exec(ctx context.Context) error { _, err := b.Save(ctx); return err }

func(b *{{ $builder }}) ExecX(ctx context.Context) { if err := b.Exec(ctx); err != nil { panic(err) } }
{{ if $one }}

func(b *{{ $builder }}) Select(columns ...ent.EntityColumn[entity.{{ $.Name }}]) *{{ $builder }} {
    if len(columns) == 0 { panic("ent: Select requires at least one column") }
    b.fields = make([]string, len(columns))
    for index, column := range columns { b.fields[index] = column.Ref().Name }
    return b
}

func(b *{{ $builder }}) SaveOld(ctx context.Context) (old *{{ $.Name }}, updated *{{ $.Name }}, err error) {
    if !b.driver.Capabilities().ReturningOld { return nil, nil, &dialect.UnsupportedError{Feature: "RETURNING OLD", Dialect: dialect.Dialect(b.driver.Dialect())} }
    b.old = &{{ $.Name }}{config: b.config}
    defer func() { b.old = nil }()
    updated, err = b.Save(ctx)
    if err != nil { return nil, nil, err }; return b.old, updated, nil
}
{{ else }}

func(b *{{ $builder }}) Returning(ctx context.Context) ([]*{{ $.Name }}, error) {
    nodes := make([]*{{ $.Name }}, 0)
    b.returning = &sqlgraph.Returning{Columns: {{ $.Package }}.Columns, Scan: func(rows dialect.Rows) error {
        _node := &{{ $.Name }}{config: b.config}
        values, err := _node.scanValues({{ $.Package }}.Columns)
        if err != nil { return err }
        if err := rows.Scan(values...); err != nil { return err }
        if err := _node.assignValues({{ $.Package }}.Columns, values); err != nil { return err }
        nodes = append(nodes, _node); return nil
    }}
    defer func() { b.returning = nil }()
    if _, err := b.Save(ctx); err != nil { return nil, err }; return nodes, nil
}
{{ end }}

func(b *{{ $builder }}) defaults() error {
    {{ range $f := $.MutableFields }}{{ if $f.UpdateDefault }}
    if b.mutation.patch.{{ $f.StructField }}.IsUnset() && b.mutation.patch.expressions[{{ $.Package }}.{{ $f.Constant }}] == nil {
        if {{ $.Package }}.{{ $f.UpdateDefaultName }} == nil { return fmt.Errorf("ent: uninitialized {{ $.Package }}.{{ $f.UpdateDefaultName }}") }
        b.mutation.patch.{{ $f.StructField }} = ent.Some({{ $.Package }}.{{ $f.UpdateDefaultName }}())
    }
    {{ end }}{{ end }}
    return nil
}

func(b *{{ $builder }}) check() error {
    if b.err != nil { return b.err }
    {{ range $f := $.MutableFields }}
    {{ if not $f.Optional }}if b.mutation.patch.{{ $f.StructField }}.IsNull() { return &ValidationError{Name: "{{ $f.Name }}", err: errors.New(`ent: field "{{ $.Name }}.{{ $f.Name }}" is not nullable`)} }{{ end }}
    {{ if or $f.IsEnum $f.Validators $f.TypeValidator }}
    if v, ok := b.mutation.patch.{{ $f.StructField }}.Get(); ok && b.mutation.patch.expressions[{{ $.Package }}.{{ $f.Constant }}] == nil {
        {{ with extend $ "Field" $f }}{{ template "write/validate" . }}{{ end }}
    }
    {{ end }}{{ end }}
    {{ range $e := $.EdgesWithID }}{{ if and $e.Unique (not $e.Immutable) (not $e.Optional) }}
    if b.mutation.patch.{{ $e.PatchSlot }}.IsNull() { return &ValidationError{Name: "{{ $e.Name }}", err: errors.New(`ent: clearing required edge "{{ $.Name }}.{{ $e.Name }}"`)} }
    {{ end }}{{ end }}
    return nil
}
{{ with extend $ "Builder" $builder "Receiver" $receiver "Package" (base $.Config.Package) }}{{ template "dialect/sql/update" . }}{{ end }}
{{ end }}
{{ range $tmpl := matchTemplate "update/additional/*" }}{{ xtemplate $tmpl $ }}{{ end }}
{{ end }}
