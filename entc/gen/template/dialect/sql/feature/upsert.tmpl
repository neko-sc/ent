type {{ $.Name }}Upsert struct { *sql.UpdateSet }

func(u *{{ $.Name }}Upsert) Set[T any](column ent.ColumnOf[entity.{{ $.Name }}, T], value T) *{{ $.Name }}Upsert {
    switch column.Ref().Name {
    {{ range $f := $.MutableFields }}
    case {{ $.Package }}.{{ $f.Constant }}:
        {{ if $f.HasValueScanner }}
        converted, err := {{ $f.ValueFunc }}(any(value).({{ $f.GoType }}))
        if err != nil { u.UpdateSet.AddError(err); return u }
        u.UpdateSet.Set(column.Ref().Name, converted)
        {{ else if $f.IsJSON }}
        encoded, err := json.Marshal(value)
        if err != nil { u.UpdateSet.AddError(err); return u }
        u.UpdateSet.Set(column.Ref().Name, json.RawMessage(encoded))
        {{ else }}u.UpdateSet.Set(column.Ref().Name, value){{ end }}
    {{ end }}
    default: u.UpdateSet.AddError(&ValidationError{Name: column.Ref().Name, err: fmt.Errorf("ent: field %q of {{ $.Name }} is not settable", column.Ref().Name)})
    }
    return u
}

