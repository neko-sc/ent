type {{ $upsert }} struct { create *{{ $builder }} }

func(b *{{ $builder }}) OnConflict(columns ...ent.EntityColumn[entity.{{ $.Name }}]) *{{ $upsert }} {
    names := make([]string, len(columns))
    for index := range columns { names[index] = columns[index].Ref().Name }
    if len(names) == 0 { return b.OnConflictOptions() }
    return b.OnConflictOptions(sql.ConflictColumns(names...))
}

func(b *{{ $builder }}) OnConflictConstraint(name string) *{{ $upsert }} { return b.OnConflictOptions(sql.ConflictConstraint(name)) }

func(b *{{ $builder }}) OnConflictOptions(options ...sql.ConflictOption) *{{ $upsert }} {
    b.conflict = options; return &{{ $upsert }}{create: b}
}

func(u *{{ $upsert }}) DoNothing() *{{ $upsert }} { u.create.conflict = append(u.create.conflict, sql.DoNothing()); return u }

func(u *{{ $upsert }}) DoSelect() *{{ $upsert }} {
    u.create.conflict = append(u.create.conflict, sql.DoSelect()); return u
}

func(u *{{ $upsert }}) Ignore() *{{ $upsert }} { u.create.conflict = append(u.create.conflict, sql.ResolveWithIgnore()); return u }

func(u *{{ $upsert }}) DoUpdate(set func(*{{ $.Name }}Upsert)) *{{ $upsert }} {
    u.create.conflict = append(u.create.conflict, sql.ResolveWith(func(update *sql.UpdateSet) { set(&{{ $.Name }}Upsert{UpdateSet: update}) })); return u
}

func(u *{{ $upsert }}) UpdateNewValues() *{{ $upsert }} {
    u.create.conflict = append(u.create.conflict, sql.ResolveWithNewValues(), sql.ResolveWith(func(update *sql.UpdateSet) {
        for _, column := range update.Columns() {
            switch column {
            {{ if $.HasOneFieldID }}case {{ $.Package }}.{{ $.ID.Constant }}: update.SetIgnore(column){{ end }}
            {{ range $f := $.ImmutableFields }}
            case {{ $.Package }}.{{ $f.Constant }}: update.SetIgnore(column)
            {{ end }}
            }
        }
    }))
    return u
}

func(u *{{ $upsert }}) Where(predicates ...ent.Predicate[entity.{{ $.Name }}]) *{{ $upsert }} {
    u.create.conflict = append(u.create.conflict, sql.ConflictWhere(sql.P(func(renderer *sql.Builder) {
        selector := sql.Dialect(renderer.Dialect()).Select().From(sql.Table({{ $.Package }}.Table))
        for _, predicate := range predicates { predicate(selector) }
        renderer.Join(selector.P())
    })))
    return u
}

func(u *{{ $upsert }}) UpdateWhere(predicates ...ent.Predicate[entity.{{ $.Name }}]) *{{ $upsert }} {
    u.create.conflict = append(u.create.conflict, sql.UpdateWhere(sql.P(func(renderer *sql.Builder) {
