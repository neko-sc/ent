}

func(u *{{ $upsert }}) Save(ctx context.Context) ({{ $result }}, error) {
    if len(u.create.conflict) == 0 { return nil, errors.New("ent: missing options for {{ $builder }}.OnConflict") }
    return u.create.Save(ctx)
}

func(u *{{ $upsert }}) Exec(ctx context.Context) error {
    _, err := u.Save(ctx)
    if errors.Is(err, ErrConflict) { return nil }; return err
}

