{{ define "dialect/sql/group" }}
{{ $builder := pascal $.Scope.Builder }}
{{ $receiver := $.Scope.Receiver }}
func ({{ $receiver }} *{{ $builder }}) selectQuery() *{{ pascal $.Name }}Select {
	selections := make([]ent.Selection, 0, len({{ $receiver }}.columns) + len({{ $receiver }}.aggregates))
	for _, column := range {{ $receiver }}.columns { selections = append(selections, column) }
	selected := {{ $receiver }}.query.Select(append(selections, {{ $receiver }}.aggregates...)...)
	selected.groups = {{ $receiver }}.columns
	return selected
}
{{ end }}
