{{/* gotype: github.com/neko-sc/ent/entc/gen.Graph */}}

{{/* custom globals and helpers for sql dialects */}}
{{ define "dialect/sql/globals" }}

// queryHook describes an internal hook for the different sqlAll methods.
type queryHook func(context.Context, *sqlgraph.QuerySpec)

// postgresColumnTypes maps the tables to the PostgreSQL types of their columns.
var postgresColumnTypes = map[string]map[string]string{
	{{- range $table, $columns := $.PostgresColumnTypes }}
		{{ printf "%q" $table }}: {
			{{- range $column, $type := $columns }}
				{{ printf "%q" $column }}: {{ printf "%q" $type }},
			{{- end }}
		},
	{{- end }}
}
{{ end }}
