func({{ $receiver }} *{{ $.CreateBulkName }}) Save(ctx context.Context) ([]*{{ $.Name }}, error) {
    if {{ $receiver }}.err != nil { return nil, {{ $receiver }}.err }
    nodes := make([]*{{ $.Name }}, len({{ $receiver }}.builders))
    specs := make([]*sqlgraph.CreateSpec, len(nodes))
    for index, builder := range {{ $receiver }}.builders {
        if builder.err != nil { return nil, builder.err }
        if err := builder.defaults(); err != nil { return nil, err }
        if err := builder.check(); err != nil { return nil, err }
        var err error
        nodes[index], specs[index], err = builder.createSpec()
        if err != nil { return nil, err }
    }
    if len(specs) == 0 { return nodes, nil }
    spec := &sqlgraph.BatchCreateSpec{Nodes: specs}
    {{ range $tmpl := matchTemplate "dialect/sql/create_bulk/spec/*" }}{{ xtemplate $tmpl $ }}{{ end }}
    if err := sqlgraph.BatchCreate(ctx, {{ $receiver }}.driver, spec); err != nil {
        if sqlgraph.IsConstraintError(err) { err = &ConstraintError{msg: err.Error(), wrap: err} }
        if errors.Is(err, dialect.ErrNoRows) { err = ErrConflict }
        return nil, err
    }
    result := nodes[:0]
    for index{{ if $.HasOneFieldID }}, builder{{ end }} := range {{ $receiver }}.builders {
        if specs[index].Skipped { continue }
        {{ if $.HasOneFieldID }}builder.mutation.id = &nodes[index].ID{{ end }}
        result = append(result, nodes[index])
    }
    return result, nil
}

func(b *{{ $.CreateBulkName }}) SaveX(ctx context.Context) []*{{ $.Name }} {
    nodes, err := b.Save(ctx); if err != nil { panic(err) }; return nodes
}

func(b *{{ $.CreateBulkName }}) Exec(ctx context.Context) error { _, err := b.Save(ctx); return err }

func(b *{{ $.CreateBulkName }}) ExecX(ctx context.Context) { if err := b.Exec(ctx); err != nil { panic(err) } }
