func({{ $receiver }} *{{ $.CreateName }}) sqlSave(ctx context.Context) (*{{ $.Name }}, error) {
    if err := {{ $receiver }}.check(); err != nil { return nil, err }
    node, spec, err := {{ $receiver }}.createSpec()
    if err != nil { return nil, err }
    if err := sqlgraph.CreateNode(ctx, {{ $receiver }}.driver, spec); err != nil {
        if sqlgraph.IsConstraintError(err) { err = &ConstraintError{msg: err.Error(), wrap: err} }
        if errors.Is(err, dialect.ErrNoRows) { err = ErrConflict }
        return nil, err
    }
    {{ if $.HasOneFieldID }}{{ $receiver }}.mutation.id = &node.ID{{ end }}
    return node, nil
}

func({{ $receiver }} *{{ $.CreateName }}) createSpec() (*{{ $.Name }}, *sqlgraph.CreateSpec, error) {
    _node := &{{ $.Name }}{config: {{ $receiver }}.config}
    _spec := sqlgraph.NewCreateSpec({{ $.Package }}.Table, {{ if $.HasOneFieldID }}sqlgraph.NewFieldSpec({{ $.Package }}.{{ $.ID.Constant }}, field.{{ $.ID.TypeConst }}){{ else }}nil{{ end }})
    {{ range $tmpl := matchTemplate "dialect/sql/create/spec/*" }}{{ xtemplate $tmpl $ }}{{ end }}
    {{ if $.HasOneFieldID }}{{ if $.ID.UserDefined }}
    if value, ok := {{ $receiver }}.mutation.insert.ID.Get(); ok {
        {{ if $.ID.HasValueScanner }}
        converted, err := {{ $.ID.ValueFunc }}(value)
        if err != nil { return nil, nil, err }
        _spec.ID.Value = converted
        {{ else }}_spec.ID.Value = {{ if and $.ID.TypeValueScanner (not $.ID.TypeNillable) }}&{{ end }}value{{ end }}
    }
    {{ end }}{{ end }}
    {{ range $f := $.MutationFields }}
    {{ if $f.InsertOptional }}if value, ok := {{ $receiver }}.mutation.insert.{{ $f.StructField }}.Get(); ok { {{ else }}if _, present := {{ $receiver }}.present[{{ $.Package }}.{{ $f.Constant }}]; !{{ $receiver }}.fromBuilder || present { value := {{ $receiver }}.mutation.insert.{{ $f.StructField }}{{ end }}
        {{ if $f.HasValueScanner }}
        converted, err := {{ $f.ValueFunc }}(value)
        if err != nil { return nil, nil, err }
        _spec.SetField({{ $.Package }}.{{ $f.Constant }}, field.{{ $f.TypeConst }}, converted)
        {{ else }}_spec.SetField({{ $.Package }}.{{ $f.Constant }}, field.{{ $f.TypeConst }}, value){{ end }}
    }
    {{ if $f.InsertOptional }}if {{ $receiver }}.mutation.insert.{{ $f.StructField }}.IsNull() { _spec.SetField({{ $.Package }}.{{ $f.Constant }}, field.{{ $f.TypeConst }}, nil) }{{ end }}
    {{ end }}
    _spec.Expressions = {{ $receiver }}.mutation.insert.expressions
    {{ range $e := $.EdgesWithID }}
    if nodes := {{ $receiver }}.mutation.insert.{{ camel $e.StructField }}IDs(); len(nodes) > 0 {
        {{ with extend $ "Edge" $e "Nodes" true "Zero" "nil" }}{{ template "dialect/sql/defedge" . }}{{ end }}
        _spec.Edges = append(_spec.Edges, edge)
    }
    {{ end }}
    _spec.Returning = &sqlgraph.Returning{Columns: {{ $.Package }}.Columns, Scan: func(rows dialect.Rows) error {
        values, err := _node.scanValues({{ $.Package }}.Columns)
        if err != nil { return err }
        if err := rows.Scan(values...); err != nil { return err }
        if err := _node.assignValues({{ $.Package }}.Columns, values); err != nil { return err }
        {{ if $.HasOneFieldID }}
        {{ if $.ID.HasValueScanner }}
        _spec.ID.Value, err = {{ $.ID.ValueFunc }}(_node.ID)
        if err != nil { return err }
        {{ else }}_spec.ID.Value = _node.ID{{ end }}
        {{ end }}
        return nil
    }}
    return _node, _spec, nil
}
