{{/* gotype: github.com/neko-sc/ent/entc/gen.Graph */}}

{{/*
The runtime template generates the schema-stitching logic and holds the
module version that was used to generate the assets.
*/}}

{{ define "runtime/ent" }}
	{{ template "runtime" $ }}
{{ end }}

{{ define "runtime/pkg" }}
	{{ with extend $ "Package" "runtime" }}
		{{ template "runtime" . }}
	{{ end }}
	{{ $module := $.ModuleInfo }}
	{{ if or $module.Version $module.Sum }}
	const (
		{{- with $module.Version }}
			Version = "{{ . }}" // Version of ent codegen.
		{{- end }}
		{{- with $module.Sum }}
			Sum = "{{ . }}" // Sum of ent codegen.
		{{- end }}
	)
	{{ end }}
{{ end }}

{{ define "runtime" }}

{{ template "header" . }}

{{ $rtpkg := false }}{{ if hasField $ "Scope" }}{{ $rtpkg = eq $.Scope.Package "runtime" }}{{ end }}

{{ if $rtpkg }}
	// The schema-stitching logic is generated in {{ $.Config.Package }}/runtime.go
{{ else }}
	{{ template "runtime/register" $ }}
{{ end }}
{{ end }}

{{/* register schema handlers to type packages */}}
{{ define "runtime/register" }}
import (
	"time"
	"context"

	{{- with $.Config.Schema }}
		"{{ . }}"
	{{- end }}
	{{- range $n := $.Nodes }}
		{{ $n.PackageAlias }} "{{ $.Config.Package }}/{{ $n.PackageDir }}"
		{{- /* Import external packages */}}
	{{- end }}
	{{- range $import := $.RuntimeSemanticImports }}
		{{ if $import.Alias }}{{ $import.Alias }} {{ end }}"{{ $import.Path }}"
	{{- end }}

	"github.com/neko-sc/ent/schema/field"
)

// The init function reads all schema descriptors with runtime code
// (default values and validators) and stitches it
// to their package variables.
func init() {
{{- range $n := $.Nodes }}
	{{- $pkg := $n.Package }}
	{{- $schema := base $.Config.Schema }}
	{{- with $n.RuntimeMixin }}
		{{ $pkg }}Mixin := {{ $schema }}.{{ $n.Name }}{}.Mixin()
	{{- end }}
	{{- if or $n.HasDefault $n.HasUpdateDefault $n.HasValidators $n.HasValueScanner }}
		{{- with $idx := $n.MixedInFields }}
			{{- range $i := $idx }}
				{{ print $pkg "MixinFields" $i }} := {{ $pkg }}Mixin[{{ $i }}].Fields()
				_ = {{ $pkg }}MixinFields{{ $i }}
			{{- end }}
		{{- end }}
		{{- $fields := $n.Fields }}{{ if $n.HasOneFieldID }}{{ if $n.ID.UserDefined }}{{ $fields = append $fields $n.ID }}{{ end }}{{ end }}
		{{- with $fields }}
			{{ $pkg }}Fields := {{ $schema }}.{{ $n.Name }}{}.Fields()
			_ = {{ $pkg }}Fields
		{{- end }}
		{{- range $i, $f := $fields }}
			{{- $desc := print $pkg "Desc" $f.StructField }}
			{{- $idscan := and $n.HasOneFieldID (eq $f.Name $n.ID.Name) }}
			{{- /* Generator-owned static enum defaults are handled near their declarations. */}}
			{{- if or (and $f.Default (or (not $f.IsEnum) $f.DefaultFunc)) $f.UpdateDefault $f.Validators (and $f.HasValueScanner (or (not $idscan) (eq $n.Storage.Name "sql"))) }}
				// {{ $desc }} is the schema descriptor for {{ $f.Name }} field.
				{{- if $f.Position.MixedIn }}
					{{ $desc }} := {{ print $pkg "MixinFields" $f.Position.MixinIndex }}[{{ $f.Position.Index }}].Descriptor()
				{{- else }}
					{{ $desc }} := {{ $pkg }}Fields[{{ $f.Position.Index }}].Descriptor()
				{{- end }}
			{{- end }}
			{{- if and $f.Default (or (not $f.IsEnum) $f.DefaultFunc) }}
				{{- $default := print $pkg "." $f.DefaultName }}
				// {{ $default }} holds the default value on creation for the {{ $f.Name }} field.
				{{- if and $f.DefinesEnumType $f.DefaultFunc }}
					{{ $fn := print $pkg $f.StructField "Default" }}
					{{ $fn }} := {{ $desc }}.Default.(func() {{ $f.BaseType }})
					{{ $default }} = func() {{ $f.GoType }} { return {{ $f.GoType }}({{ $fn }}()) }
				{{- else }}
					{{- $defaultType := $f.GoType }}{{ if $f.DefaultFunc }}{{ $defaultType = print "func() " $f.GoType }}{{ end }}
					{{ $default }} = {{ $desc }}.Default.({{ $defaultType }})
				{{- end }}
			{{- end }}
			{{- if $f.UpdateDefault }}
				{{- $default := print $pkg "." $f.UpdateDefaultName }}
				// {{ $default }} holds the default value on update for the {{ $f.Name }} field.
				{{- if $f.DefinesEnumType }}
					{{ $fn := print $pkg $f.StructField "UpdateDefault" }}
					{{ $fn }} := {{ $desc }}.UpdateDefault.(func() {{ $f.BaseType }})
					{{ $default }} = func() {{ $f.GoType }} { return {{ $f.GoType }}({{ $fn }}()) }
				{{- else }}
					{{ $default }} = {{ $desc }}.UpdateDefault.(func() {{ $f.GoType }})
				{{- end }}
			{{- end }}
			{{- if and $f.HasValueScanner (or (not $idscan) (eq $n.Storage.Name "sql")) }}
				{{- $valuescan := print $pkg ".ValueScanner." $f.StructField }}
				{{ $valuescan }} = {{ $desc }}.ValueScanner.(field.TypeValueScanner[{{ $f.GoType }}])
			{{- end }}
			{{- with $f.Validators }}
				{{- $name := print $pkg "." $f.Validator }}
				// {{ $name }} is a validator for the "{{ $f.Name }}" field. It is called by the builders before save.
				{{ $name }} = func(value {{ $f.GoType }}) error {
					validators := {{ $desc }}.Validators
					{{- range $j, $_ := $f.ValidatorKinds }}
						{{- if $f.ValidatorUsesLogicalValue $j }}
							if err := validators[{{ $j }}].(func({{ $f.BaseType }}) error)({{ $f.BasicType "value" }}); err != nil {
								return err
							}
						{{- else }}
							if err := validators[{{ $j }}].(func({{ $f.GoType }}) error)(value); err != nil {
								return err
							}
						{{- end }}
					{{- end }}
					return nil
				}
		{{- end }}
	{{- end }}
{{- end }}
{{- end }}
}
{{ end }}
